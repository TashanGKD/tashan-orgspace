NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4110
# Development-only Vite proxy target. Production Web always uses its own origin.
PUBLIC_API_URL=http://127.0.0.1:4110
DATABASE_URL=
ORGSPACE_LOCAL_POSTGRES_PASSWORD=
REDIS_URL=redis://127.0.0.1:56379
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TRUSTED_PROXY_CIDRS=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
PHONE_PROVIDER=disabled
PHONE_CODE_PEPPER=
# Required only when PHONE_PROVIDER=aliyun. Disabled never sends a real SMS.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
