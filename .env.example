NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4110
# Development-only Vite proxy target. Production Web always uses its own origin.
PUBLIC_API_URL=http://127.0.0.1:4110
DATABASE_URL=
ORGSPACE_LOCAL_POSTGRES_PASSWORD=
ORGSPACE_LOCAL_POSTGRES_PORT=55432
ORGSPACE_LOCAL_REDIS_PORT=56379
ORGSPACE_LOCAL_S3_PORT=59000
REDIS_URL=redis://127.0.0.1:56379
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ORIGIN=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=orgspace-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# The API server now requires true; false remains the safe config-validation default.
FILE_STORAGE_ENABLED=false
# Required only when the partner module is enabled. Keys are 32-byte base64url values.
PARTNER_STORAGE_ENABLED=false
PARTNER_FIELD_ACTIVE_KEY_VERSION=
PARTNER_FIELD_KEYS=
PARTNER_BLIND_INDEX_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TRUSTED_PROXY_CIDRS=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
PHONE_PROVIDER=disabled
PHONE_CODE_PEPPER=
# Required only when PHONE_PROVIDER=aliyun. Disabled never sends a real SMS.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
SMS_DELIVERY_ENABLED=false
ALIYUN_SMS_NOTIFICATION_TEMPLATE_CODE=
ALIYUN_SMS_NOTIFICATION_TEMPLATE_PARAM_KEY=content
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
