{
  "name": "tashan-orgspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test:gate-self": "node scripts/check-toolchain.self-test.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
