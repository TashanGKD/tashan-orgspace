{
  "name": "tashan-orgspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test:gate-self": "node scripts/check-toolchain.self-test.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm -r test",
    "test:e2e": "tsx tests/e2e/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tashan/contracts": "workspace:*",
    "@tashan/sdk": "workspace:*",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "jose": "6.2.9",
    "prettier": "3.9.6",
    "redis": "6.2.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
