{
  "name": "@tashan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset:test": "tsx src/db/migrate.ts --reset-test",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tashan/contracts": "workspace:*",
    "argon2": "0.45.1",
    "jose": "6.2.9",
    "postgres": "3.4.9",
    "redis": "6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tashan/testkit": "workspace:*",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
