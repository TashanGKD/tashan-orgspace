{
  "name": "@tashan/cli",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "bin": {
    "torg": "./src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tashan/capabilities": "workspace:*",
    "@tashan/sdk": "workspace:*",
    "commander": "15.0.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tashan/testkit": "workspace:*",
    "@types/ws": "8.18.1",
    "jose": "6.2.9",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
